# ===========================================
# RAQI KE - AI Sales Dashboard Backend
# Production Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# -------------------------------------------
# Application
# -------------------------------------------
APP_NAME=AI Sales Dashboard
APP_ENV=production
DEBUG=false
API_PREFIX=/api/v1

# -------------------------------------------
# Security (CHANGE THESE IN PRODUCTION)
# -------------------------------------------
SECRET_KEY=CHANGE-ME-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# -------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------
DATABASE_URL=postgresql+psycopg2://dashboard:CHANGE_ME@localhost:5432/dashboard

# -------------------------------------------
# Redis (for rate limiting - optional in dev)
# -------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -------------------------------------------
# Rate Limiting
# -------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20

# -------------------------------------------
# CORS (comma-separated origins)
# -------------------------------------------
CORS_ORIGINS=["https://app.yourdomain.com"]

# -------------------------------------------
# Google Sheets Legacy Compatibility
# Set to false to disable all Google Sheets I/O
# -------------------------------------------
SHEETS_COMPAT_MODE=false

# Google service account credentials (only needed if SHEETS_COMPAT_MODE=true)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# SHEETS_ORDERS_ID=your-sheet-id
# SHEETS_ORDERS_TAB=Commandes
# SHEETS_PRODUCTS_ID=your-sheet-id
# SHEETS_PRODUCTS_TAB=الورقة1
# SHEETS_POSTS_ID=your-sheet-id
# SHEETS_POSTS_TAB=الورقة1

# -------------------------------------------
# Storage (local or S3)
# -------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=storage/media
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=your-bucket
# S3_ACCESS_KEY=your-key
# S3_SECRET_KEY=your-secret
# S3_REGION=us-east-1
# S3_PUBLIC_BASE_URL=https://your-bucket.s3.amazonaws.com

# -------------------------------------------
# Couriers / Yalidine
# -------------------------------------------
TRACKING_POLL_INTERVAL_SECONDS=300
TRACKING_STALE_MINUTES=30
DEFAULT_FROM_WILAYA=Alger
YALIDINE_API_BASE_URL=https://api.yalidine.app/v1

# -------------------------------------------
# Feature Toggles
# -------------------------------------------
RETURNS_ENABLED=true
SHIPMENTS_ENABLED=true

# -------------------------------------------
# AI Assistant
# Set AI_PROVIDER=openai and provide OPENAI_API_KEY
# for production LLM responses.
# -------------------------------------------
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -------------------------------------------
# Meta / Facebook / Instagram Integration
# Required for social comment automation.
# -------------------------------------------
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_IG_ACCOUNT_ID=

# -------------------------------------------
# Observability (optional)
# -------------------------------------------
SENTRY_DSN=

# -------------------------------------------
# Sync intervals (legacy Sheets compatibility)
# -------------------------------------------
SYNC_ORDERS_INTERVAL_SECONDS=30
SYNC_PRODUCTS_INTERVAL_SECONDS=60
RECONCILE_INTERVAL_SECONDS=300
