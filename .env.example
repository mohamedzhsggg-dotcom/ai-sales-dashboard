# AI Sales Dashboard - environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (docker-compose defaults) ---
DATABASE_URL=postgresql+psycopg2://dashboard:dashboard@localhost:5432/dashboard
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=dashboard
POSTGRES_DB=dashboard

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Google Sheets (service account JSON key path) ---
# Create a service account in Google Cloud, enable Google Sheets API,
# share the 3 spreadsheets with the service account email (Editor),
# and point GOOGLE_APPLICATION_CREDENTIALS at the downloaded JSON file.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# --- Spreadsheet IDs (already wired to the existing n8n sheets) ---
SHEETS_ORDERS_ID=1_-k6B8LfGeW6ayT3-gfPT_2IJEW7kf4pqFa8tubrDA0
SHEETS_ORDERS_TAB=Commandes
SHEETS_PRODUCTS_ID=1PDfe5zGhGMoveWaM9gdNZmiksMeDUDnVVAFIOadDp3Q
SHEETS_PRODUCTS_TAB=الورقة1
SHEETS_POSTS_ID=1CbDGkABKJG1Jq9SuAeJHiEY7Hf_Uo_OvrKe1GwoDQ3o
SHEETS_POSTS_TAB=الورقة1

# --- Sync cadence ---
SYNC_ORDERS_INTERVAL_SECONDS=30
SYNC_PRODUCTS_INTERVAL_SECONDS=60
RECONCILE_INTERVAL_SECONDS=300